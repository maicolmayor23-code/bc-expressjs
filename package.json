{
  "name": "proyecto-semana-05",
  "version": "1.0.0",
  "description": "Week 05 — Project: Express REST API with PostgreSQL & Prisma ORM (DJ / Sonido y Luces)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.0",
    "express": "5.1.0",
    "morgan": "^1.11.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "22.15.21",
    "prisma": "6.4.0",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
